<Window x:Class="SignalDx.LogQsoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log QSO"
        Width="480" Height="420"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Cascadia Mono, Consolas, Courier New"
        FontSize="13">
  <DockPanel Margin="14">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
      <TextBlock DockPanel.Dock="Left" Text="QSO complete — review and log"
                 Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Log QSO" Click="Log_Click" Style="{StaticResource AccentButton}"
                IsDefault="True" MinWidth="100"/>
        <Button Content="Skip" Click="Skip_Click" IsCancel="True" MinWidth="90" Margin="0"/>
      </StackPanel>
    </DockPanel>

    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" Padding="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="DX Call"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,10,8"
                 Text="{Binding DxCall, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Grid.Row="0" Grid.Column="2" Content="DX Grid"/>
        <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,8"
                 Text="{Binding DxGrid, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="1" Grid.Column="0" Content="My Call"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,10,8"
                 Text="{Binding MyCall, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Grid.Row="1" Grid.Column="2" Content="My Grid"/>
        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,8"
                 Text="{Binding MyGrid, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Band"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,10,8"
                 Text="{Binding Band, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Grid.Row="2" Grid.Column="2" Content="Mode"/>
        <TextBox Grid.Row="2" Grid.Column="3" Margin="0,0,0,8"
                 Text="{Binding Mode, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Dial MHz"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,10,8"
                 Text="{Binding DialMhz, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Grid.Row="3" Grid.Column="2" Content="End UTC"/>
        <TextBlock Grid.Row="3" Grid.Column="3" Margin="0,0,0,8" VerticalAlignment="Center"
                   Text="{Binding UtcEnd, StringFormat=yyyy-MM-dd HH:mm:ss}"
                   Foreground="{StaticResource AccentBrush}"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Start UTC"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,10,8" VerticalAlignment="Center"
                   Text="{Binding UtcStart, StringFormat=yyyy-MM-dd HH:mm:ss}"
                   Foreground="{StaticResource MutedBrush}"/>

        <Label Grid.Row="5" Grid.Column="0" Content="Sent"/>
        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,10,8"
                 Text="{Binding SentRst, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Report you sent"/>
        <Label Grid.Row="5" Grid.Column="2" Content="Rcvd"/>
        <TextBox Grid.Row="5" Grid.Column="3" Margin="0,0,0,8"
                 Text="{Binding RcvdRst, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Report you received"/>

        <Label Grid.Row="6" Grid.Column="0" Content="Comment"/>
        <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8"
                 Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Text="Edit any fields, then Log QSO to write the local log and external logbooks. Skip discards this QSO."/>
      </Grid>
    </Border>
  </DockPanel>
</Window>
