<Window x:Class="SignalDx.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Signal DX"
        Width="460" Height="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220"
        BorderBrush="#2A3A55"
        BorderThickness="1">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/SignalDx.png"
                   Width="96" Height="96"
                   HorizontalAlignment="Center"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Clip>
                    <RectangleGeometry Rect="0,0,96,96" RadiusX="20" RadiusY="20"/>
                </Image.Clip>
            </Image>
            <TextBlock Text="SIGNAL DX"
                       FontSize="26" FontWeight="Bold"
                       Foreground="#E7EEF8"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0"/>
            <TextBlock Text="Digi Console"
                       FontSize="13"
                       Foreground="#8FA3BF"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="CreatorText"
                       FontSize="12"
                       Foreground="#3FC0E0"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <ProgressBar IsIndeterminate="True"
                         Height="3"
                         Foreground="#3FC0E0"
                         Background="#182338"
                         BorderThickness="0"/>
            <DockPanel Margin="0,8,0,0">
                <TextBlock x:Name="VersionText"
                           DockPanel.Dock="Right"
                           FontSize="11"
                           Foreground="#8FA3BF"/>
                <TextBlock Text="Starting..."
                           FontSize="11"
                           Foreground="#8FA3BF"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
