<Window x:Class="SignalDx.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:SignalDx.Helpers"
        Title="Signal DX — Settings"
        Width="920" Height="640"
        MinWidth="640" MinHeight="420"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Cascadia Mono, Consolas, Courier New"
        FontSize="13">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Bottom" Padding="0,10,0,0">
      <DockPanel>
        <TextBlock Text="{Binding CatStatus}" Foreground="{StaticResource GoodBrush}"
                   VerticalAlignment="Center" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Save" Command="{Binding SaveSettingsCommand}" Style="{StaticResource AccentButton}"
                  IsDefault="True" MinWidth="90"/>
          <Button Content="Close" Click="Close_Click" IsCancel="True" MinWidth="90" Margin="0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
          <Setter Property="Padding" Value="14,8"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border x:Name="TabBorder" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0"
                        Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="TabBorder" Property="Background" Value="#1C2A44"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>

      <!-- Audio -->
      <TabItem Header="Audio">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <TextBlock Text="Sound devices" FontWeight="SemiBold"
                             Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshAudioDevicesCommand}"
                          ToolTip="Rescan Windows capture and playback devices"/>
                </DockPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Label Grid.Row="0" Grid.Column="0" Content="Input"/>
                  <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                            ItemsSource="{Binding InputDevices}"
                            SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}"
                            ToolTip="Radio audio into the PC (USB codec, VAC, or mic). Saved as soon as you pick one."/>
                  <Label Grid.Row="1" Grid.Column="0" Content="Output"/>
                  <ComboBox Grid.Row="1" Grid.Column="1"
                            ItemsSource="{Binding OutputDevices}"
                            SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                            ToolTip="Audio back to the radio (same interface TX path). Saved as soon as you pick one."/>
                </Grid>
                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="Input is the radio audio into the PC. Output is the audio sent back to the radio. After you pick them, click Monitor on the main window and watch the RX level bar — aim for mid-scale."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Hamlib / CAT -->
      <TabItem Header="Hamlib / CAT">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <DockPanel Margin="0,0,0,12">
              <TextBlock Text="RIG STATUS" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding RigFreqText}" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,16,0"/>
                <TextBlock Text="{Binding RigModeText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="{Binding RigPttText}" VerticalAlignment="Center"
                           Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold"/>
              </StackPanel>
            </DockPanel>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Connection" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <Label Grid.Row="0" Grid.Column="0" Content="Backend"/>
                  <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,8"
                            ItemsSource="{Binding CatBackends}" SelectedItem="{Binding SelectedCatBackend}"/>
                  <Label Grid.Row="0" Grid.Column="2" Content="Baud"/>
                  <TextBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,8"
                           Text="{Binding CatBaud, UpdateSourceTrigger=PropertyChanged}"/>

                  <Label Grid.Row="1" Grid.Column="0" Content="Model filter"/>
                  <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Reload models" Command="{Binding RefreshHamlibModelsCommand}" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding HamlibModelFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Filter by id, manufacturer, or model (e.g. 7300, Icom, FT-991)"/>
                  </DockPanel>

                  <Label Grid.Row="2" Grid.Column="0" Content="Hamlib model"/>
                  <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,12,8"
                            ItemsSource="{Binding HamlibModelChoices}"
                            SelectedIndex="{Binding SelectedHamlibModelIndex}"
                            IsEditable="False"/>
                  <TextBlock Grid.Row="2" Grid.Column="3" Margin="0,0,0,8"
                             VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                             Text="{Binding HamlibModelCountText}"/>

                  <Label Grid.Row="3" Grid.Column="0" Content="Device"/>
                  <DockPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="↻ Ports" Command="{Binding RefreshPortsCommand}"
                            Margin="6,0,0,0"/>
                    <ComboBox ItemsSource="{Binding ComPorts}" IsEditable="True"
                              Text="{Binding HamlibDeviceDisplay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="All COM / USB-serial devices with friendly names"/>
                  </DockPanel>

                  <Label Grid.Row="4" Grid.Column="0" Content="TCP host"/>
                  <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,12,8"
                           Text="{Binding CatHost, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Hamlib: rigctld host. HRD: usually localhost"/>
                  <Label Grid.Row="4" Grid.Column="2" Content="rigctld port"/>
                  <TextBox Grid.Row="4" Grid.Column="3" Margin="0,0,0,8"
                           Text="{Binding CatPort, UpdateSourceTrigger=PropertyChanged}"/>

                  <Label Grid.Row="5" Grid.Column="0" Content="Serial COM"/>
                  <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,0,12,0" IsEditable="True"
                            ItemsSource="{Binding ComPorts}"
                            Text="{Binding CatComPort, UpdateSourceTrigger=PropertyChanged}"/>
                  <Label Grid.Row="5" Grid.Column="2" Content="HRD port"/>
                  <TextBox Grid.Row="5" Grid.Column="3" Margin="0,0,0,8"
                           Text="{Binding HrdPort, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Ham Radio Deluxe Rig Control TCP port (default 7809)"/>
                </Grid>
                <DockPanel Margin="0,4,0,0">
                  <Label Content="rigctld path" DockPanel.Dock="Left"/>
                  <Button DockPanel.Dock="Right" Content="Find" Command="{Binding FindRigctldCommand}" Margin="6,0,0,0"/>
                  <TextBox Text="{Binding HamlibRigctldPath, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="Tip: filter “Deluxe” or “HRD” to select Ham Radio Deluxe (virtual model 9999). Start HRD Rig Control first, then Connect — no rigctld needed."/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Rig actions" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <WrapPanel>
                  <Label Content="Mode"/>
                  <ComboBox Width="100" ItemsSource="{Binding HamlibModes}" SelectedItem="{Binding HamlibMode}"/>
                  <Button Content="Set mode" Command="{Binding SetRigModeCommand}" Margin="6,0,0,0"/>
                  <Button Content="Set dial → rig" Command="{Binding SetRigFreqCommand}" Margin="6,0,0,0"/>
                  <Button Content="PTT" Command="{Binding TogglePttCommand}" Style="{StaticResource TxButton}" Margin="10,0,0,0"/>
                  <Button Content="Refresh" Command="{Binding RefreshRigCommand}" Margin="6,0,0,0"/>
                </WrapPanel>
                <WrapPanel Margin="0,10,0,0">
                  <CheckBox Content="Auto-start rigctld" IsChecked="{Binding HamlibAutoStart}"/>
                  <CheckBox Content="PTT on TX" IsChecked="{Binding CatPttEnabled}"/>
                  <CheckBox Content="Follow dial" IsChecked="{Binding CatFollowDial}"
                            ToolTip="Reserved for continuous dial sync. Picking a band preset always sets the radio frequency when CAT is connected."/>
                </WrapPanel>
                <WrapPanel Margin="0,12,0,0">
                  <Button Content="Start rigctld" Command="{Binding StartRigctldCommand}"/>
                  <Button Content="Stop rigctld" Command="{Binding StopRigctldCommand}"/>
                  <Button Content="Connect" Command="{Binding ConnectCatCommand}" Style="{StaticResource AccentButton}" Margin="10,0,0,0"/>
                  <Button Content="Disconnect" Command="{Binding DisconnectCatCommand}"/>
                </WrapPanel>
                <TextBlock Text="{Binding RigInfoText}" Foreground="{StaticResource MutedBrush}"
                           Margin="0,10,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Logbooks -->
      <TabItem Header="Logbooks">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="WSJT-X UDP (Log4OM, Logger32, HRD, …)" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <WrapPanel>
                  <CheckBox Content="Enable UDP logging" IsChecked="{Binding UdpLogEnabled}"/>
                  <Label Content="Host" Margin="16,0,0,0"/>
                  <TextBox Width="140" Text="{Binding UdpLogHost, UpdateSourceTrigger=PropertyChanged}"/>
                  <Label Content="Port" Margin="8,0,0,0"/>
                  <TextBox Width="70" Text="{Binding UdpLogPort, UpdateSourceTrigger=PropertyChanged}"/>
                </WrapPanel>
                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="Sends Heartbeat, QSO Logged, and Logged ADIF packets compatible with WSJT-X/JTDX listeners."/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="PSK Reporter" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <CheckBox Content="Enable PSK Reporter spotting" IsChecked="{Binding PskReporterEnabled}" Margin="0,0,0,6"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="Sends decoded FT8/FT4/WSPR spots (call, RF freq, SNR, mode) to report.pskreporter.info every ~2 minutes. WSPR2 is reported as mode WSPR. Requires your call and grid."/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="WSPRnet" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <CheckBox Content="Upload WSPR spots to wsprnet.org" IsChecked="{Binding WsprUploadSpots}" Margin="0,0,0,6"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="In WSPR2 mode, decoded spots are also posted to wsprnet.org (single-spot POST / batch MEPT). Independent of PSK Reporter — enable both to report to both. Requires your call and grid."/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="ADIF file" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <CheckBox Content="Append each logged QSO to ADIF file" IsChecked="{Binding AdifAppendEnabled}" Margin="0,0,0,8"/>
                <DockPanel>
                  <Label Content="Path" DockPanel.Dock="Left"/>
                  <TextBox Text="{Binding AdifPath, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <Button Content="Export full log as ADIF…" Command="{Binding ExportAdifCommand}"
                        HorizontalAlignment="Left" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Club Log" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <CheckBox Content="Upload on Log QSO" IsChecked="{Binding ClubLogEnabled}" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Label Content="Email"/>
                  <TextBox Grid.Column="1" Margin="0,0,12,0"
                           Text="{Binding ClubLogEmail, UpdateSourceTrigger=PropertyChanged}"/>
                  <Label Grid.Column="2" Content="Password"/>
                  <PasswordBox Grid.Column="3"
                               helpers:PasswordBoxBinder.BindPassword="True"
                               helpers:PasswordBoxBinder.BoundPassword="{Binding ClubLogPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12">
              <StackPanel>
                <TextBlock Text="QRZ Logbook" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <CheckBox Content="Upload on Log QSO" IsChecked="{Binding QrzEnabled}" Margin="0,0,0,8"/>
                <DockPanel>
                  <Label Content="API key" DockPanel.Dock="Left"/>
                  <PasswordBox helpers:PasswordBoxBinder.BindPassword="True"
                               helpers:PasswordBoxBinder.BoundPassword="{Binding QrzApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Text="QRZ call lookup" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                           Margin="0,16,0,8"/>
                <CheckBox Content="Look up when selecting Band/RX activity" IsChecked="{Binding QrzLookupOnSelect}"
                          Margin="0,0,0,6"/>
                <CheckBox Content="Fill empty DX grid from QRZ" IsChecked="{Binding QrzFillGrid}" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Label Content="Username"/>
                  <TextBox Grid.Column="1" Margin="0,0,12,0"
                           Text="{Binding QrzUsername, UpdateSourceTrigger=PropertyChanged}"/>
                  <Label Grid.Column="2" Content="Password"/>
                  <PasswordBox Grid.Column="3"
                               helpers:PasswordBoxBinder.BindPassword="True"
                               helpers:PasswordBoxBinder.BoundPassword="{Binding QrzPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="QRZ.com login for XML callsign lookup. Full name/grid/country needs a QRZ Logbook Data subscription. Double-click an RX row or use the QRZ button to view the call on qrz.com."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Decoder -->
      <TabItem Header="Decoder">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="FT8 / FT4 decode engine" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding DecoderStatusText}" Margin="0,0,0,10"
                           Foreground="{StaticResource AccentBrush}"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <Label Grid.Row="0" Grid.Column="0" Content="jtdxjt9"/>
                  <DockPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Find" Command="{Binding FindJtdxCommand}" Margin="6,0,0,0"/>
                    <TextBox Text="{Binding JtdxJt9Path, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Path to jtdxjt9.exe — run from its bin folder for DLL resolution"/>
                  </DockPanel>

                  <Label Grid.Row="1" Grid.Column="0" Content="Depth"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0"
                           Text="{Binding JtdxDecodeDepth, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="jtdxjt9 -d depth (1–3)"/>
                </Grid>
                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="The Windows installer ships jtdxjt9 under Tools\JTDX (plus WSJT ft8code and Hamlib). Find uses the bundled copy first, then any system install. Start Monitor so a full slot of audio is buffered. HRD is not bundled — pick Ham Radio Deluxe as CAT backend if you already run HRD Rig Control."/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Display -->
      <TabItem Header="Display">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12">
              <StackPanel>
                <TextBlock Text="Waterfall colors" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <WrapPanel>
                  <Label Content="Palette"/>
                  <ComboBox Width="140" ItemsSource="{Binding WaterfallPalettes}"
                            SelectedItem="{Binding SelectedWaterfallPalette}"/>
                </WrapPanel>
                <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="Classic, Amber, Ice, Green, Magenta, Gray, Heat. New spectrum lines use the selected palette immediately; older waterfall history keeps prior colors until it scrolls off."/>
                <CheckBox Content="Lock Tx = Rx when picking on waterfall"
                          IsChecked="{Binding LockTxToRx}" Margin="0,14,0,0"/>
                <CheckBox Content="Show call signs on the waterfall"
                          IsChecked="{Binding WaterfallCallSigns}" Margin="0,8,0,0"
                          ToolTip="Each decoded station's call is shown along the bottom of the waterfall at its frequency, for the last two decode slots. Wanted calls (call, state, or country) have a red background with white text. The station you are calling in the current QSO has a green background with white text. Stations that only called you stay the normal color."/>
                <CheckBox Content="Play sound when a station calls my callsign"
                          IsChecked="{Binding CallAlertEnabled}" Margin="0,14,0,6"/>
                <DockPanel Margin="0,0,0,0">
                  <Label Content="Alert sound" Width="88" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ClearCallAlertSoundCommand}" Margin="6,0,0,0"
                          ToolTip="Clear custom file and use built-in call-alert.wav"/>
                  <Button DockPanel.Dock="Right" Content="Test" Command="{Binding TestCallAlertCommand}" Margin="6,0,0,0"/>
                  <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCallAlertSoundCommand}" Margin="6,0,0,0"/>
                  <TextBox Text="{Binding CallAlertSoundPath, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Choose a .wav / .mp3 file, or leave blank for the built-in call-alert.wav"/>
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Wanted -->
      <TabItem Header="Wanted">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Wanted alerts" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <CheckBox Content="Audio alert when a Wanted station is decoded"
                          IsChecked="{Binding WantedAlertEnabled}" Margin="0,0,0,6"/>
                <CheckBox Content="CQ only (alert when they call out, not every decode)"
                          IsChecked="{Binding WantedAlertCqOnly}" Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,8">
                  <Label Content="Wanted sound" Width="100" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ClearWantedAlertSoundCommand}" Margin="6,0,0,0"
                          ToolTip="Clear custom file and use built-in wanted-alert.wav"/>
                  <Button DockPanel.Dock="Right" Content="Test" Command="{Binding TestWantedAlertCommand}" Margin="6,0,0,0"/>
                  <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseWantedAlertSoundCommand}" Margin="6,0,0,0"/>
                  <TextBox Text="{Binding WantedAlertSoundPath, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Choose a .wav / .mp3 file, or leave blank for the built-in wanted-alert.wav (distinct 3-note chime)"/>
                </DockPanel>
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="Matches the transmitting station’s call, US/CA state, or country. Plays an audio alert and highlights the row in red in Band Activity / RX Frequency."/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Wanted list" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                  <ComboBox Width="100" ItemsSource="{Binding WantedKindChoices}"
                            SelectedIndex="{Binding SelectedWantedKindIndex}"
                            VerticalAlignment="Center"
                            ToolTip="Call = exact callsign · State = IL / ON · Country = Japan / England"/>
                  <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddWantedCommand}"
                          Style="{StaticResource AccentButton}" MinWidth="72" Margin="8,0,0,0"/>
                  <TextBox Margin="8,0,0,0"
                           Text="{Binding NewWantedValue, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Examples: K1ABC · IL · Japan · England"/>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                           Text="{Binding WantedFilePath, StringFormat=Saved to {0}}"/>
                <ListBox ItemsSource="{Binding WantedItems}" MinHeight="220"
                         Background="#0E1626" BorderBrush="{StaticResource BorderBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="4,2">
                        <Button DockPanel.Dock="Right" Content="Remove"
                                Command="{Binding DataContext.RemoveWantedCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="8,2" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}"/>
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Backup -->
      <TabItem Header="Backup">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Back up and restore" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Save your settings, QSO log, ADIF log, Wanted list and worked calls to one zip file. After a clean reinstall, restore that zip to get everything back."/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Back up…" Command="{Binding BackupSettingsCommand}"
                          Style="{StaticResource AccentButton}" MinWidth="110"
                          ToolTip="Save a backup zip anywhere you like (USB drive, cloud folder, …)"/>
                  <Button Content="Restore…" Command="{Binding RestoreSettingsCommand}" MinWidth="110"
                          ToolTip="Pick a backup zip. Signal DX restarts to apply it."/>
                </StackPanel>
                <TextBlock Text="{Binding BackupStatusText}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource GoodBrush}"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" Padding="12">
              <StackPanel>
                <TextBlock Text="What is included" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <TextBlock Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="All settings (station, audio devices, CAT, decoder, display, macros, alerts), QSO log, ADIF log, Wanted list, worked calls."/>
                <TextBlock Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="The backup includes your QRZ and Club Log passwords and API keys in plain text. Keep the zip somewhere private."/>
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Not included: custom alert sound files (only their paths are saved) and the bundled JTDX / Hamlib tools, which the installer provides."/>
                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"
                           Text="{Binding BackupDataFolder, StringFormat=Live data folder: {0}}"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- About -->
      <TabItem Header="About">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" Padding="20">
            <StackPanel>
              <TextBlock Text="{Binding AboutProductName}" FontSize="22" FontWeight="Bold"
                         Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>

              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Creator"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AboutCreator}"
                           FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Call sign"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AboutCreatorCall}"
                           FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Email"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AboutCreatorEmail}"
                           FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Version"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AboutVersion}"
                           FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Version date"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AboutVersionDate}"
                           FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Date created"
                           Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AboutDateCreated}"
                           FontWeight="SemiBold"/>
              </Grid>

              <TextBlock Margin="0,20,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                         Text="{Binding AboutTagline}"/>

              <TextBlock Margin="0,18,0,8" FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}"
                         Text="Updates"/>
              <CheckBox Content="Check for updates automatically on startup"
                        IsChecked="{Binding CheckForUpdatesOnStartup}"
                        Margin="0,0,0,8"/>
              <TextBlock Text="{Binding UpdateStatusText}"
                         Foreground="{StaticResource GoodBrush}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8"/>
              <ProgressBar Height="8"
                           Minimum="0" Maximum="100"
                           Value="{Binding UpdateDownloadProgress, Mode=OneWay}"
                           Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}"
                           Margin="0,0,0,8"/>
              <WrapPanel Margin="0,0,0,4">
                <Button Content="Check for updates"
                        Command="{Binding CheckForUpdatesCommand}"
                        Margin="0,0,8,8"
                        ToolTip="Check GitHub Releases for a newer version of Signal DX"/>
                <Button Content="Download &amp; install update"
                        Command="{Binding InstallUpdateCommand}"
                        Style="{StaticResource AccentButton}"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,8,8"
                        ToolTip="Download the verified Setup installer, close Signal DX cleanly, and launch the upgrade"/>
                <Button Content="Release notes"
                        Command="{Binding OpenAvailableReleaseCommand}"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,8"
                        ToolTip="Open this release on GitHub"/>
              </WrapPanel>
              <Border Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                      Background="{StaticResource BgBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1"
                      Padding="10"
                      Margin="0,4,0,8">
                <TextBlock Text="{Binding UpdateReleaseNotes}"
                           Foreground="{StaticResource TextBrush}"
                           TextWrapping="Wrap"
                           FontSize="12"/>
              </Border>

              <TextBlock Margin="0,18,0,8" FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}"
                         Text="Documentation"/>
              <WrapPanel Margin="0,0,0,4">
                <Button Content="Open how-to guide"
                        Command="{Binding OpenHowtoCommand}"
                        Style="{StaticResource AccentButton}"
                        Margin="0,0,8,8"
                        ToolTip="Opens the bundled operator how-to (PDF preferred)"/>
                <Button Content="Open README"
                        Command="{Binding OpenReadmeCommand}"
                        Margin="0,0,8,8"
                        ToolTip="Opens the project README"/>
                <Button Content="Download how-to PDF"
                        Command="{Binding OpenHowtoPdfDownloadCommand}"
                        Margin="0,0,8,8"
                        ToolTip="Download SignalDx-HOWTO.pdf from GitHub Releases"/>
                <Button Content="Releases"
                        Command="{Binding OpenReleasesCommand}"
                        Margin="0,0,0,8"
                        ToolTip="GitHub Releases (installer + how-to PDF)"/>
              </WrapPanel>
              <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                         Text="The how-to covers first-time setup (audio, decoder, CAT, logging) and product features. A PDF is also available from Releases."/>

              <TextBlock Margin="0,10,0,6" FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}"
                         Text="Acknowledgments"/>
              <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                         Text="{Binding AboutAcknowledgments}"/>
            </StackPanel>
          </Border>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>

