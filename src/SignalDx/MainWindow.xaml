<Window x:Class="SignalDx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SignalDx.Controls"
        xmlns:conv="clr-namespace:SignalDx.Converters"
        Title="Signal DX — Digi Console"
        Icon="Assets/SignalDx.ico"
        Width="1440" Height="920"
        MinWidth="900" MinHeight="560"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
    <conv:BoolToBrushConverter x:Key="CqHighlight"
                               TrueBrush="#33280A"
                               FalseBrush="Transparent"/>
    <conv:BoolToBrushConverter x:Key="WantedHighlight"
                               TrueBrush="#4A1212"
                               FalseBrush="Transparent"/>
    <conv:WorkingCallBrushConverter x:Key="WorkingCallBrushConverter"/>
    <conv:FlagImageConverter x:Key="FlagImage"/>
    <Style x:Key="ActivityRowStyle" TargetType="DataGridRow">
      <Setter Property="Background" Value="{Binding IsCqStyleHighlight, Converter={StaticResource CqHighlight}}"/>
      <Setter Property="Foreground">
        <Setter.Value>
          <MultiBinding Converter="{StaticResource WorkingCallBrushConverter}">
            <Binding Path="IsToMe"/>
            <Binding Path="DxCall"/>
            <Binding Path="Message"/>
            <Binding Path="DataContext.ActiveQsoCall" RelativeSource="{RelativeSource AncestorType=Window}"/>
            <Binding Path="IsPreviouslyWorked"/>
          </MultiBinding>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsPreviouslyWorked}" Value="True">
          <Setter Property="Opacity" Value="0.78"/>
        </DataTrigger>
        <!-- Not on ALLCALL7 (possible false decode) — dimmed. Before Wanted so a Wanted match still shows in full red. -->
        <DataTrigger Binding="{Binding IsUnverified}" Value="True">
          <Setter Property="Opacity" Value="0.45"/>
        </DataTrigger>
        <!-- Wanted call/state/country — red row + red text (with audio alert). Last so it wins over worked dimming. -->
        <DataTrigger Binding="{Binding IsWanted}" Value="True">
          <Setter Property="Background" Value="#4A1212"/>
          <Setter Property="Foreground" Value="#FF4545"/>
          <Setter Property="BorderBrush" Value="#FF4545"/>
          <Setter Property="BorderThickness" Value="0,0,0,1"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Opacity" Value="1"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ActivityCellStyle" TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground"
              Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#1C3A55"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Strikethrough for previously worked transmitters (text cells). -->
    <Style x:Key="ActivityTextBlockStyle" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsPreviouslyWorked}" Value="True">
          <Setter Property="TextDecorations" Value="Strikethrough"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <DockPanel Margin="10">
    <!-- Brand / station -->
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,0,0,8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <TextBlock Text="SIGNAL DX" FontSize="22" FontWeight="Bold"
                     Foreground="{StaticResource AccentBrush}" Margin="0,0,18,0" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
            <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding UtcClockText}" FontSize="26" FontWeight="Bold"
                         Foreground="{StaticResource CqBrush}" HorizontalAlignment="Right"
                         ToolTip="UTC clock"/>
              <TextBlock Text="UTC" FontSize="11" Foreground="{StaticResource MutedBrush}"
                         HorizontalAlignment="Right" Margin="0,-2,0,0"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center" MinWidth="160">
              <TextBlock Text="{Binding CurrentFreqText}" FontSize="16" FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"
                         ToolTip="RF = dial + audio offset (Hz)"/>
              <TextBlock Text="FREQ" FontSize="11" Foreground="{StaticResource MutedBrush}"
                         HorizontalAlignment="Right" Margin="0,-2,0,0"/>
            </StackPanel>
            <Button Content="{Binding UpdateBadgeText}"
                    Command="{Binding InstallUpdateCommand}"
                    Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}"
                    Background="#1F5E38"
                    BorderBrush="#3FB950"
                    Foreground="#FFFFFF"
                    FontWeight="SemiBold"
                    ToolTip="A newer version of Signal DX is available — click to download &amp; install"/>
            <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource AccentButton}"/>
            <Button Content="How-to" Command="{Binding OpenHowtoCommand}"
                    ToolTip="Open the operator how-to guide (PDF / README)"/>
            <Button Content="Export ADIF" Command="{Binding ExportAdifCommand}"/>
          </StackPanel>
          <WrapPanel VerticalAlignment="Center">
            <Label Content="My Call"/>
            <TextBox Width="90" Text="{Binding MyCall, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="Grid" Margin="8,0,0,0"/>
            <TextBox Width="60" Text="{Binding MyGrid, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="Mode" Margin="8,0,0,0"/>
            <ComboBox Width="70" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"/>
            <Label Content="Band" Margin="8,0,0,0"/>
            <TextBox Width="50" Text="{Binding Band, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="Dial" Margin="8,0,0,0"/>
            <TextBox Width="90" Text="{Binding DialMhz, UpdateSourceTrigger=LostFocus}"
                     KeyDown="Dial_OnKeyDown"
                     ToolTip="Dial in MHz — type a frequency and press Enter to tune the radio (CAT)"/>
            <Label Content="MHz" Margin="2,0,0,0"/>
            <Label Content="{Binding TxDriveLabel}" Margin="12,0,4,0" MinWidth="88"
                   Foreground="{StaticResource WarnBrush}"/>
            <Slider Width="160" Minimum="0" Maximum="100" TickFrequency="1"
                    IsMoveToPointEnabled="True" IsSnapToTickEnabled="False"
                    VerticalAlignment="Center" MinHeight="22"
                    Value="{Binding TxDrivePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="PC TX audio level (0–100%). A direct Hamlib radio does not get a mic-gain change. HRD is unchanged."/>
            <TextBlock Text="{Binding RxLevelText}" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource GoodBrush}" MinWidth="72"
                       ToolTip="RX audio input level (dB FS) — aim for mid-scale with Monitor running"/>
            <ProgressBar Width="80" Height="12" Minimum="0" Maximum="1" Value="{Binding RxLevelNorm}"
                         VerticalAlignment="Center" Margin="6,0,0,0"
                         ToolTip="RX audio level — raise radio AF / VAC until the bar is roughly mid-scale"/>
            <TextBlock Text="{Binding AlcText}" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource WarnBrush}" MinWidth="72"
                       ToolTip="Radio ALC when CAT reports it; shows DRV% from the Drive slider while transmitting"/>
            <ProgressBar Width="80" Height="12" Minimum="0" Maximum="1" Value="{Binding AlcLevel}"
                         VerticalAlignment="Center" Margin="6,0,0,0"
                         ToolTip="ALC from radio (CAT) or TX Drive while transmitting"/>
            <TextBlock Text="{Binding RfPowerText}" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" MinWidth="64"/>
          </WrapPanel>
        </DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
          <Label Content="DX"/>
          <TextBox Width="100" Text="{Binding DxCall, UpdateSourceTrigger=PropertyChanged}"
                   CharacterCasing="Upper"
                   Foreground="{StaticResource WorkingCallBrush}" CaretBrush="{StaticResource WorkingCallBrush}"
                   ToolTip="Type a callsign for macros, or pick from Band/RX. Click Apply in TX MACROS to load it."/>
          <Label Content="Grid" Margin="8,0,0,0"/>
          <TextBox Width="60" Text="{Binding DxGrid, UpdateSourceTrigger=PropertyChanged}"
                   CharacterCasing="Upper"/>
          <Label Content="Rpt" Margin="8,0,0,0"/>
          <TextBox Width="50" Text="{Binding Report, UpdateSourceTrigger=PropertyChanged}"/>
          <Button Content="QRZ" Command="{Binding LookupQrzCommand}" Margin="8,0,0,0"
                  ToolTip="Open DX call on qrz.com in your browser"/>
          <Button Content="Open" Command="{Binding OpenQrzCommand}" Margin="4,0,0,0"
                  ToolTip="Open DX call on qrz.com in your browser"/>
          <TextBlock Text="{Binding QrzInfoText}" Margin="10,0,0,0" VerticalAlignment="Center"
                     Foreground="{StaticResource GoodBrush}" TextTrimming="CharacterEllipsis"
                     MaxWidth="420" ToolTip="{Binding QrzInfoText}"/>
          <Label Content="Phase" Margin="12,0,0,0"/>
          <TextBlock Text="{Binding PhaseLabel}" Foreground="{StaticResource CqBrush}"
                     VerticalAlignment="Center" Width="110"/>
          <ComboBox Width="200" Margin="12,0,0,0" ItemsSource="{Binding BandPresets}"
                    SelectedIndex="{Binding SelectedBandPresetIndex}"
                    DropDownOpened="BandPreset_OnDropDownOpened"
                    DropDownClosed="BandPreset_OnDropDownClosed"
                    ToolTip="Pick a band/dial — applied immediately (and sent to the radio when CAT is connected)."/>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Status -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10,6" Margin="0,8,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="{Binding CatStatus}" Foreground="{StaticResource GoodBrush}" Margin="0,0,14,0"/>
          <TextBlock Text="{Binding RigFreqText}" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
          <TextBlock Text="{Binding RigPttText}" Foreground="{StaticResource WarnBrush}"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <DockPanel Margin="0,0,0,4">
            <TextBlock Text="{Binding UtcClockText}" DockPanel.Dock="Left"
                       Foreground="{StaticResource CqBrush}" FontWeight="SemiBold" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding SlotLabel}" HorizontalAlignment="Right"
                       Foreground="{StaticResource MutedBrush}"/>
          </DockPanel>
          <ProgressBar Value="{Binding SlotProgress}" Maximum="1"
                       ToolTip="FT8/FT4/WSPR slot progress (red while transmitting)">
            <ProgressBar.Style>
              <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsTransmitting}" Value="True">
                    <Setter Property="Foreground" Value="#FF4545"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Style>
          </ProgressBar>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="MainLayoutGrid">
      <Grid.RowDefinitions>
        <RowDefinition x:Name="MainRowOps" Height="Auto"/>
        <RowDefinition x:Name="MainRowWspr" Height="Auto"/>
        <RowDefinition x:Name="MainRowWaterfall" Height="2.2*" MinHeight="120"/>
        <RowDefinition Height="6"/>
        <RowDefinition x:Name="MainRowActivity" Height="3.5*" MinHeight="160"/>
      </Grid.RowDefinitions>

      <!-- Ops row (second toolbar) -->
      <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
        <DockPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="Monitor" Command="{Binding StartMonitorCommand}" Style="{StaticResource AccentButton}"/>
            <Button Content="Stop" Command="{Binding StopMonitorCommand}"/>
            <Button Content="Enable TX" Command="{Binding EnableTxCommand}"
                    Style="{StaticResource EnableTxToggleButton}"
                    ToolTip="Arm TX (red = armed, blue = idle)"/>
            <Button Content="Halt Tx" Command="{Binding HaltTxCommand}"/>
            <Button Content="Tune" Command="{Binding TuneCommand}"
                    Style="{StaticResource TuneToggleButton}"
                    ToolTip="Continuous tone at Tx Hz for SWR/ALC — max 60s; click again or Halt to stop"/>
            <CheckBox Content="Auto seq" IsChecked="{Binding AutoSequence}" Margin="12,0,0,0"
                      Visibility="{Binding IsFtDigiMode, Converter={StaticResource BoolToVis}}"/>
            <CheckBox Content="Call alert" IsChecked="{Binding CallAlertEnabled}"
                      Visibility="{Binding IsFtDigiMode, Converter={StaticResource BoolToVis}}"
                      ToolTip="Play a sound when a station calls your callsign"/>
            <CheckBox Content="Wanted alert" IsChecked="{Binding WantedAlertEnabled}" Margin="8,0,0,0"
                      ToolTip="Play a sound when a Wanted call/state/country is decoded (Settings → Wanted)"/>
            <CheckBox Content="TX even" IsChecked="{Binding TxEven}"
                      Visibility="{Binding IsFtDigiMode, Converter={StaticResource BoolToVis}}"/>
            <CheckBox Content="Lock Tx=Rx" IsChecked="{Binding LockTxToRx}" Margin="12,0,0,0"/>
            <Label Content="Rx" Margin="12,0,0,0"/>
            <TextBox Width="55" Text="{Binding RxHz, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="Tx" Margin="8,0,0,0"/>
            <TextBox Width="55" Text="{Binding TxHz, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{Binding TxHzToolTip}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- WSPR-2 toolbar (below ops; shown only in WSPR2 mode) -->
      <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,6"
              Margin="0,0,0,8"
              Visibility="{Binding IsWsprMode, Converter={StaticResource BoolToVis}}">
        <WrapPanel VerticalAlignment="Center">
          <TextBlock Text="WSPR-2" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                     VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button Content="Tx next" Command="{Binding WsprTxNextCommand}" Style="{StaticResource TxButton}"
                  ToolTip="Force a WSPR transmission on the next 2-minute slot (JTDX/WSJT-X Tx next)"/>
          <Label Content="Tx %" Margin="12,0,0,0"
                 ToolTip="Average percentage of 2-minute slots used for TX (random, like JTDX/WSJT-X)"/>
          <TextBox Width="40" Text="{Binding WsprTxPercent, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="0 = never (unless Tx next), 100 = every slot, typical 20–25"/>
          <Label Content="Power" Margin="12,0,0,0"/>
          <ComboBox Width="140"
                    ItemsSource="{Binding WsprPowerChoices}"
                    SelectedItem="{Binding SelectedWsprPowerLabel}"
                    ToolTip="WSPR reported TX power (dBm) — encoded in the beacon"/>
          <Label Content="Tx Hz" Margin="12,0,0,0"/>
          <TextBox Width="55" Text="{Binding TxHz, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="{Binding TxHzToolTip}"/>
          <CheckBox Content="Upload spots" IsChecked="{Binding WsprUploadSpots}" Margin="14,4,0,0"
                    ToolTip="Upload decoded WSPR spots to wsprnet.org"/>
          <TextBlock Text="{Binding WsprScheduleText}" Margin="14,4,0,0" VerticalAlignment="Center"
                     Foreground="{StaticResource CqBrush}" MinWidth="160"/>
          <TextBlock Text="{Binding FreeText}" Margin="14,4,0,0" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}"
                     ToolTip="Beacon message (call grid dBm)"/>
        </WrapPanel>
      </Border>

      <!-- Waterfall -->
      <Border Grid.Row="2" Background="#05080F" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" ClipToBounds="True">
        <DockPanel Background="#05080F">
          <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}"
                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <WrapPanel VerticalAlignment="Center">
              <TextBlock Text="Start" Foreground="{StaticResource MutedBrush}" FontSize="11"
                         VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBox Width="60" Margin="0,0,14,0" VerticalAlignment="Center"
                       Text="{Binding WaterfallStartHz, UpdateSourceTrigger=LostFocus}"
                       ToolTip="Left edge of the waterfall, in Hz (WSJT-X Start)."/>
              <TextBlock Text="Bins/Pixel" Foreground="{StaticResource MutedBrush}" FontSize="11"
                         VerticalAlignment="Center" Margin="0,0,4,0"/>
              <ComboBox Width="56" Margin="0,0,14,0" VerticalAlignment="Center"
                        ItemsSource="{Binding WaterfallBinsChoices}"
                        SelectedItem="{Binding WaterfallBinsPerPixel}"
                        ToolTip="4 shows the whole passband. 1 is the narrowest zoom (WSJT-X Bins/Pixel)."/>
              <TextBlock Text="N Avg" Foreground="{StaticResource MutedBrush}" FontSize="11"
                         VerticalAlignment="Center" Margin="0,0,4,0"/>
              <ComboBox Width="56" Margin="0,0,14,0" VerticalAlignment="Center"
                        ItemsSource="{Binding WaterfallAvgChoices}"
                        SelectedItem="{Binding WaterfallAvg}"
                        ToolTip="Spectra averaged into each row. 1 is every update (WSJT-X N Avg)."/>
              <CheckBox Content="Flatten" IsChecked="{Binding WaterfallFlatten}" Margin="0,0,14,0"
                        VerticalAlignment="Center"
                        ToolTip="Subtract a wide baseline so a tilted noise floor sits flat (WSJT-X Flatten)."/>
              <TextBlock Text="Colors" Foreground="{StaticResource MutedBrush}" FontSize="11"
                         VerticalAlignment="Center" Margin="0,0,4,0"/>
              <ComboBox Width="100" Margin="0,0,14,0" VerticalAlignment="Center"
                        ItemsSource="{Binding WaterfallPalettes}"
                        SelectedItem="{Binding SelectedWaterfallPalette}"
                        ToolTip="Waterfall color palette."/>
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center"
                          ToolTip="Higher Gain brightens traces. Around 40 a normal signal stays colored. 80 pushes strong traces toward white. Raise Zero if the background fills in.">
                <TextBlock Text="Gain" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Slider Width="120" Minimum="0" Maximum="80" TickFrequency="1"
                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Value="{Binding WaterfallGain}"/>
                <TextBlock Text="{Binding WaterfallGain}" Foreground="{StaticResource TextBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="4,0,0,0" MinWidth="20"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                          ToolTip="Higher Zero hides weaker traces and keeps the background solid (WSJT-X Zero).">
                <TextBlock Text="Zero" Foreground="{StaticResource MutedBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Slider Width="100" Minimum="0" Maximum="30" TickFrequency="1"
                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        VerticalAlignment="Center" Value="{Binding WaterfallZero}"/>
                <TextBlock Text="{Binding WaterfallZero}" Foreground="{StaticResource TextBrush}" FontSize="11"
                           VerticalAlignment="Center" Margin="4,0,0,0" MinWidth="20"/>
              </StackPanel>
            </WrapPanel>
          </Border>
          <Grid>
          <controls:WaterfallControl x:Name="Waterfall"/>
          <DockPanel Margin="8,6,8,30" IsHitTestVisible="False">
            <TextBlock DockPanel.Dock="Top" Foreground="#6F86A8" FontSize="11">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="WATERFALL — click a trace for Rx/Tx  ·  scale bar shows Hz"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsWsprMode}" Value="True">
                      <Setter Property="Text" Value="WSPR-2 — 1400–1600 Hz passband  ·  2-minute time marks  ·  click to set Tx"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock DockPanel.Dock="Bottom" HorizontalAlignment="Right" Foreground="#6F86A8" FontSize="11">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="L-click Rx(+Tx)  ·  R-click/Shift Tx  ·  cyan=Rx  orange=Tx"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsWsprMode}" Value="True">
                      <Setter Property="Text" Value="Avoid crowded 1500 Hz  ·  cyan=Rx  orange=Tx  ·  soft traces = weak WSPR"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </DockPanel>
          </Grid>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                    Background="{StaticResource BorderBrush}" ShowsPreview="True"
                    ToolTip="Drag to resize waterfall / activity"/>

      <!-- Activity panes + macros -->
      <Grid x:Name="ActivityLayoutGrid" Grid.Row="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="ColBand" Width="1.4*" MinWidth="160"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition x:Name="ColRx" Width="*" MinWidth="140"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition x:Name="ColMacros" Width="0.85*" MinWidth="120"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="8,6">
              <TextBlock Text="BAND ACTIVITY" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
              <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearActivityCommand}"
                      HorizontalAlignment="Right" Padding="8,2"
                      ToolTip="Clear Band Activity only. RX Frequency stays."/>
            </DockPanel>
            <DataGrid x:Name="BandActivityGrid"
                      ItemsSource="{Binding Activity}" SelectedItem="{Binding SelectedActivityDecode}"
                      MouseDoubleClick="Activity_OnMouseDoubleClick"
                      CellStyle="{StaticResource ActivityCellStyle}"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True">
              <DataGrid.RowStyle>
                <StaticResource ResourceKey="ActivityRowStyle"/>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="UTC" Binding="{Binding Utc, StringFormat=HH:mm:ss}"
                                   Width="70" MinWidth="40"
                                   ElementStyle="{StaticResource ActivityTextBlockStyle}"/>
                <DataGridTextColumn Header="dB" Binding="{Binding SnrDb, StringFormat=0.0}"
                                   Width="44" MinWidth="28"
                                   ElementStyle="{StaticResource ActivityTextBlockStyle}"/>
                <DataGridTextColumn Header="DT" Binding="{Binding Dt, StringFormat=0.00}"
                                   Width="44" MinWidth="28"
                                   ElementStyle="{StaticResource ActivityTextBlockStyle}"/>
                <DataGridTextColumn Header="Hz" Binding="{Binding Hz}"
                                   Width="50" MinWidth="32"
                                   ElementStyle="{StaticResource ActivityTextBlockStyle}"/>
                <DataGridTextColumn Header="mi" Binding="{Binding DistanceText}"
                                   Width="48" MinWidth="28"
                                   ElementStyle="{StaticResource ActivityTextBlockStyle}"/>
                <DataGridTemplateColumn Header="Flag" Width="64" MinWidth="48">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0"
                                  ToolTip="{Binding CountryText}">
                        <Image Source="{Binding FlagImageKey, Converter={StaticResource FlagImage}}"
                               Width="22" Height="15" Stretch="Uniform"
                               SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding FlagStateBadge}" Margin="4,0,0,0"
                                   Style="{StaticResource ActivityTextBlockStyle}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Country" Binding="{Binding CountryText}"
                                   Width="120" MinWidth="48"
                                   ElementStyle="{StaticResource ActivityTextBlockStyle}"/>
                <DataGridTextColumn Header="ST" Binding="{Binding StateText}"
                                   Width="44" MinWidth="28"
                                   ElementStyle="{StaticResource ActivityTextBlockStyle}"/>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}"
                                   Width="280" MinWidth="80"
                                   ElementStyle="{StaticResource ActivityTextBlockStyle}"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource BorderBrush}" ShowsPreview="True"
                      ToolTip="Drag to resize Band Activity / RX"/>

        <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="8,6">
              <TextBlock Text="RX FREQUENCY" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="QRZ" Command="{Binding LookupQrzCommand}" Padding="8,2" Margin="0,0,6,0"
                        ToolTip="Open selected / DX call on qrz.com in your browser"/>
                <Button Content="Reset seq" Command="{Binding ResetSeqCommand}" Padding="8,2" Margin="0,0,6,0"
                        ToolTip="Clear the QSO state back to idle"
                        Visibility="{Binding IsFtDigiMode, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Clear" Command="{Binding ClearRxActivityCommand}" Padding="8,2"/>
              </StackPanel>
            </DockPanel>
            <DataGrid x:Name="RxActivityGrid"
                      ItemsSource="{Binding RxActivity}" SelectedItem="{Binding SelectedRxDecode}"
                      MouseDoubleClick="RxActivity_OnMouseDoubleClick"
                      CellStyle="{StaticResource ActivityCellStyle}"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True">
              <DataGrid.RowStyle>
                <StaticResource ResourceKey="ActivityRowStyle"/>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="UTC" Binding="{Binding Utc, StringFormat=HH:mm:ss}"
                                   Width="70" MinWidth="40"
                                   ElementStyle="{StaticResource ActivityTextBlockStyle}"/>
                <DataGridTextColumn Header="dB" Binding="{Binding SnrDb, StringFormat=0.0}"
                                   Width="44" MinWidth="28"
                                   ElementStyle="{StaticResource ActivityTextBlockStyle}"/>
                <DataGridTextColumn Header="Hz" Binding="{Binding Hz}"
                                   Width="50" MinWidth="32"
                                   ElementStyle="{StaticResource ActivityTextBlockStyle}"/>
                <DataGridTextColumn Header="mi" Binding="{Binding DistanceText}"
                                   Width="48" MinWidth="28"
                                   ElementStyle="{StaticResource ActivityTextBlockStyle}"/>
                <DataGridTemplateColumn Header="Flag" Width="64" MinWidth="48">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0"
                                  ToolTip="{Binding CountryText}">
                        <Image Source="{Binding FlagImageKey, Converter={StaticResource FlagImage}}"
                               Width="22" Height="15" Stretch="Uniform"
                               SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding FlagStateBadge}" Margin="4,0,0,0"
                                   Style="{StaticResource ActivityTextBlockStyle}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedBrush}"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}"
                                   Width="280" MinWidth="80"
                                   ElementStyle="{StaticResource ActivityTextBlockStyle}"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Background="{StaticResource BorderBrush}" ShowsPreview="True"
                      ToolTip="Drag to resize RX / macros"/>

        <Border Grid.Column="4" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="TX MACROS" FontWeight="SemiBold"
                         Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetTxMacrosCommand}"
                      Padding="8,2" HorizontalAlignment="Right"
                      ToolTip="Rebuild TX free-text from standard CQ / QSO templates"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Label Content="Call" VerticalAlignment="Center" Padding="0,0,6,0"/>
              <Button DockPanel.Dock="Right" Content="Apply" Command="{Binding ApplyManualDxCommand}"
                      Padding="10,2" Margin="6,0,0,0"
                      ToolTip="Load typed callsign into macros (Tx1) and free-text"/>
              <TextBox Width="70" DockPanel.Dock="Right" Margin="6,0,0,0"
                       Text="{Binding DxGrid, UpdateSourceTrigger=PropertyChanged}"
                       CharacterCasing="Upper"
                       ToolTip="Optional DX grid"/>
              <Label DockPanel.Dock="Right" Content="Grid" VerticalAlignment="Center" Padding="0,0,4,0"/>
              <TextBox Text="{Binding DxCall, UpdateSourceTrigger=PropertyChanged}"
                       CharacterCasing="Upper"
                       VerticalContentAlignment="Center"
                       ToolTip="Type DX callsign, then Apply (or press Enter)"
                       KeyDown="ManualDxCall_OnKeyDown"/>
            </DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Add" Command="{Binding AddCustomMacroCommand}"
                      Padding="10,2" Margin="6,0,0,0"
                      ToolTip="Save a custom macro (e.g. CQ DX / CQ EU). Right-click a custom button to remove."/>
              <TextBox DockPanel.Dock="Left" Width="64" Margin="0,0,6,0"
                       Text="{Binding NewCustomMacroLabel, UpdateSourceTrigger=PropertyChanged}"
                       CharacterCasing="Upper"
                       VerticalContentAlignment="Center"
                       ToolTip="Button label (e.g. CQ DX)"/>
              <TextBox Text="{Binding NewCustomMacroTemplate, UpdateSourceTrigger=PropertyChanged}"
                       CharacterCasing="Upper"
                       VerticalContentAlignment="Center"
                       ToolTip="Template tokens: {mycall} {mygrid} {dxcall} {snr} — e.g. CQ DX {mycall} {mygrid}"/>
            </DockPanel>
            <TextBox DockPanel.Dock="Bottom" Margin="0,8,0,0"
                     Text="{Binding FreeText, UpdateSourceTrigger=PropertyChanged}"/>
            <ItemsControl ItemsSource="{Binding Macros}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding DataContext.SendMacroCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"
                          Style="{StaticResource TxButton}"
                          Margin="0,0,6,6" Height="48"
                          ToolTip="{Binding Preview}">
                    <Button.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Remove custom macro"
                                  Command="{Binding DataContext.RemoveCustomMacroCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Visibility="{Binding PlacementTarget.DataContext.IsCustom, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BoolToVis}}"/>
                      </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding Preview}" FontSize="11" Opacity="0.85"
                                 HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                 MaxWidth="160"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
